	<ThingDef ParentName="ResourceBase">
		<defName>ESCP_TrollBlood</defName>
		<label>troll blood</label>
		<description>Blood from a dead troll, possesses strong regenerative abilities. Can be used to make elixirs of regeneration at a drug lab.</description>
